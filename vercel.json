{
  "functions": {
    "autolib-student-web/server.js": {
      "includeFiles": "autolib-student-web/public/**"
    },
    "autolib-student-web/api/index.js": {
      "includeFiles": "autolib-student-web/public/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/autolib-student-web/api"
    },
    {
      "source": "/healthz",
      "destination": "/autolib-student-web/api"
    }
  ]
}
