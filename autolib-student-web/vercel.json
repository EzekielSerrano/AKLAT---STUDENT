{
  "functions": {
    "server.js": {
      "includeFiles": "public/**"
    },
    "api/index.js": {
      "includeFiles": "public/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/healthz",
      "destination": "/api"
    }
  ]
}
