# Copy to .env (or set these in your hosting dashboard). Never commit real secrets.

# Same PostgreSQL database the librarian desktop app uses
DATABASE_URL=postgres://autolib_web:CHANGE_ME@your-db-host:5432/autolib_db

# Set to true when the database requires SSL (most managed databases do)
DB_SSL=true

# Long random string, e.g. run:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

NODE_ENV=production
PORT=3000

# Set to true when running behind a reverse proxy / hosting platform (Render, Railway, Caddy, Nginx...)
TRUST_PROXY=true
